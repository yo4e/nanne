{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nanne",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "exports": {
    "Room": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
